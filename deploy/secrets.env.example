# Copy to deploy/secrets.env, which git ignores, and fill in the variables your
# shoc.yaml names. Compose hands this file to serve and the workers only.
#
# One SHOC_SECRET_<NAME>_<KEY>=value per line. A shoc.yaml may name only
# variables that start with SHOC_SECRET_. The names below are the ones
# `shoc init-config` and docs/connectors.md use; yours are whatever your
# shoc.yaml says.

# Microsoft (entra, m365, defender, defender_hunting, azure_activity)
# SHOC_SECRET_MS_TENANT_ID=
# SHOC_SECRET_MS_CLIENT_ID=
# SHOC_SECRET_MS_CLIENT_SECRET=

# Okta
# SHOC_SECRET_OKTA_API_TOKEN=

# GitHub
# SHOC_SECRET_GITHUB_AUDIT_TOKEN=

# AWS CloudTrail
# SHOC_SECRET_AWS_ACCESS_KEY_ID=
# SHOC_SECRET_AWS_SECRET_ACCESS_KEY=

# Slack
# SHOC_SECRET_SLACK_BOT_TOKEN=
# SHOC_SECRET_SLACK_SIGNING_SECRET=
