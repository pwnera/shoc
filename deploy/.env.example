# Copy to .env next to docker-compose.yml.
# Set the four database passwords below first: without them Compose runs
# nothing, keygen included.
# Generate the master key with: docker compose run --rm --no-deps shoc keygen
# (--no-deps: otherwise migrate runs first, and refuses replace-me as too short)
SHOC_MASTER_KEY=replace-me
SHOC_TENANT=default
# Dry run keeps every action proposal-only. Turn it off once you trust the install.
SHOC_DRY_RUN=1

# Where the API listens. Docker's port publishing bypasses ufw and similar
# firewalls, so 0.0.0.0 here means the public internet on most hosts. Keep it on
# loopback or a private (VPN) address unless there is TLS and tokens in front.
SHOC_BIND=127.0.0.1
SHOC_PORT=8080

# Bearer tokens. Until a token or an account exists, anyone who can reach the
# port is a full human principal, which is fine on loopback and never anywhere
# else. Issue the first:
#   docker compose run --rm shoc token create --who you@example.com --role admin
# SHOC_TOKENS is the other way in, and needs a restart to change. A token acts on
# SHOC_TENANT unless its entry names a "tenant".
# A person's token names a role: admin, operator, deployer or reader.
# SHOC_TOKENS={"<token>":{"role":"admin","id":"you"}}
# Without a token or an account, serve only starts with SHOC_BIND on loopback
# and refuses any request that came through a proxy or from a web page.

# People sign in to the console with an account (RFC 0028). Set the address
# they open it at, recreate shoc and worker so they read it, then invite the
# first admin:
#   docker compose up -d
#   docker compose run --rm shoc user invite you@example.com --role admin
# Serve the console over https, because on plain http the session cookie is
# sent to every port of this host.
# SHOC_PUBLIC_URL=https://shoc.example.com
# Mail for invitation and reset links; without it the link is returned once.
# smtps:// is TLS, usually on 465; smtp:// must offer STARTTLS, usually on 587.
# SHOC_SMTP_URL=smtps://user:pass@mail.example.com:465
# SHOC_MAIL_FROM=shoc@example.com
# Networks whose X-Forwarded-For sign-in limits believe. The default covers
# loopback and Docker's 172.16.0.0/12; add a TLS terminator on another host,
# and have it append X-Forwarded-For.
# SHOC_TRUSTED_PROXIES=127.0.0.0/8,::1/128,172.16.0.0/12

# Database roles (deploy/postgres-init): shoc owns the schema and only the
# migrate service uses it; serve and worker run as shoc_app, which cannot
# change the audit log. An install from before shoc_app existed: see
# docs/deploy.md, "Upgrading to the runtime role".
# Required. Generate each with `openssl rand -hex 24` (hex, because they go
# into connection strings). Postgres takes them only when its volume is first
# created: an install that ran with the old defaults sets them to shoc,
# shoc_app, shoc_agent and postgres, or changes them in Postgres first.
SHOC_DB_PASSWORD=
SHOC_APP_DB_PASSWORD=
SHOC_AGENT_DB_PASSWORD=
POSTGRES_SUPERUSER_PASSWORD=

# The read-only role agents query through: shoc grant-readonly prints this.
# SHOC_READONLY_DSN=postgresql://shoc_agent:...@postgres:5432/shoc

# Events in Snowflake (STO-4): set SHOC_BACKEND=snowflake and SHOC_EXTRAS=snowflake.
# Sign in with a key pair: an unencrypted PKCS#8 PEM on one line, newlines
# written \n. SHOC_SNOWFLAKE_PASSWORD is the fallback.
# SHOC_SNOWFLAKE_ACCOUNT=
# SHOC_SNOWFLAKE_USER=
# SHOC_SNOWFLAKE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n
# SHOC_SNOWFLAKE_PASSWORD=
# SHOC_SNOWFLAKE_WAREHOUSE=
# SHOC_SNOWFLAKE_ROLE=
# SHOC_SNOWFLAKE_READONLY_ROLE=

# The crew's model (docs/deploy.md lists the rest of SHOC_LLM_*).
# SHOC_LLM_PROVIDER=anthropic
# SHOC_LLM_MODEL=
# SHOC_LLM_MODEL_CHEAP=
# SHOC_LLM_API_KEY=

# Days of events kept, and `off` to contact no threat-intel feed on its own.
# SHOC_RETENTION_DAYS=90
# SHOC_INTEL_FEEDS=off

# An outside monitor's URL, pinged after each hourly health check so a dead host
# is noticed by something that is not shoc. The worker logs only its host.
# SHOC_HEARTBEAT_URL=https://hc-ping.com/<uuid>
# The disk Postgres may fill, in GB: 80% is an alert, 90% a page.
# SHOC_DISK_BUDGET_GB=50

# The image tag. edge is main as of its last green CI run.
# SHOC_VERSION=edge

# SHOC_SECRET_* variables that a config file names go in secrets.env next to
# this file. Compose hands serve and worker that file whole, and takes from
# this one only the names docker-compose.yml lists.
