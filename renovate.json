{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits", "helpers:pinGitHubActionDigests"],
  "schedule": ["before 6am on monday"],
  "packageRules": [
    { "groupName": "python dependencies", "matchManagers": ["pep621"] },
    { "groupName": "github actions", "matchManagers": ["github-actions"] }
  ],
  "vulnerabilityAlerts": { "labels": ["kind/security"], "schedule": ["at any time"] }
}
